    "fonts": [
      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      99.38,
      257.4,
      526.79,
      271.46
    ],
    "text": "the State (which are synonymous) outweighs the previous good character,",
