    "page_number": 4,
    "bbox": [
      99.38,
      215.16,
      526.7,
      229.22
    ],
    "text": "the criminal, though no doubt an important consideration, is subordinate",
    "fonts": [
      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      99.38,
      236.28,
      526.88,
      250.34
    ],
