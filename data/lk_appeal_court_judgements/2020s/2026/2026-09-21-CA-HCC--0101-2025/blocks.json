  {
    "page_number": 4,
    "bbox": [
      99.38,
      194.04,
      526.78,
      208.1
    ],
    "text": "also matters which should receive due consideration. The reformation of",
    "fonts": [
      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
  },
