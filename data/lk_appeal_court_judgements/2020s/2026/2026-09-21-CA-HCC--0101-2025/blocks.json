      "BookmanOldStyle",
      "BookmanOldStyle-Bold"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      78.02,
      635.57,
      205.25,
      649.57
    ],
    "text": "BASNAYAKE, A.C.J.-",
