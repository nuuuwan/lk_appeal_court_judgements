    "fonts": [
      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      260.69,
      35.25,
      342.73,
      45.8
    ],
    "text": "CA/HCC/0101/2025",
    "fonts": [
      "Cambria"
    ],
    "sizes": [
      9.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      474.22,
      758.02,
      525.92,
      769.06
    ],
    "text": "5 | P a g e",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      11.039999961853027
    ]
  },
