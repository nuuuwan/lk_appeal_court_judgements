      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      99.38,
      708.92,
      526.81,
      722.98
    ],
    "text": "should have regard to the punishment provided in the Penal Code or other",
    "fonts": [
      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      99.38,
      730.04,
      526.68,
      744.1
    ],
