    "bbox": [
      99.38,
      287.43,
      526.91,
      301.49
    ],
    "text": "also upon its harmfulness. The question is whether the consequences of",
    "fonts": [
      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
