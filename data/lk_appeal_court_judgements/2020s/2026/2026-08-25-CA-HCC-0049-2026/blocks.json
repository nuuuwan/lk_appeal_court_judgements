  {
    "page_number": 5,
    "bbox": [
      99.38,
      308.55,
      526.7,
      322.61
    ],
    "text": "the offence can be taken as the measure for determining its harmfulness?",
    "fonts": [
      "BookmanOldStyle-Italic"
    ],
    "sizes": [
      12.0
    ]
