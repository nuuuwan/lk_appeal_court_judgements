    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.03,
      669.01,
      526.26,
      682.29
    ],
    "text": "The Petitioner further asserts that it became aware, in 2024, there had been notices published",
