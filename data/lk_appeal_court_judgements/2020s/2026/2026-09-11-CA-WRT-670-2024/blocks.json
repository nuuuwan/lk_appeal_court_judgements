      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      72.03,
      135.86,
      526.25,
      149.14
    ],
    "text": "Having duly filled the application and submitted the relevant supporting documents, the same",
