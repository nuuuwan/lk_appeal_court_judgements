    "page_number": 2,
    "bbox": [
      72.03,
      262.14,
      526.42,
      275.42
    ],
    "text": "discretionary power to withhold liquor licences, when the Commissioner General of Excise",
    "fonts": [
      "TimesNewRomanPSMT"
