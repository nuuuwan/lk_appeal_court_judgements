    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.03,
      542.71,
      525.96,
      555.99
    ],
    "text": "Companies Act, No. 07 of 2007 of Sri Lanka, and that it was incorporated for the purpose of",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      12.0
    ]
  },
