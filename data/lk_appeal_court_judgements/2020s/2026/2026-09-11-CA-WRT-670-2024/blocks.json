      "TimesNewRomanPSMT"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.03,
      724.28,
      525.95,
      737.56
    ],
    "text": "Upon becoming aware of the said advertisement and the calling for applications, the Petitioner,",
