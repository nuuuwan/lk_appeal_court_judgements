    "page_number": 3,
    "bbox": [
      108.02,
      701.11,
      543.27,
      715.18
    ],
    "text": "Judge and cannot be delegated. The law has advisedly cast this duty on",
    "fonts": [
      "Bookman Old Style,Italic"
    ],
    "sizes": [
      12.0
    ]
  },
