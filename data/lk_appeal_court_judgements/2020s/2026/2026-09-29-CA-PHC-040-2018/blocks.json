    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.02,
      289.25,
      542.68,
      393.53
    ],
    "text": "The Respondent-Petitioner-Appellant (hereinafter referred to as the \u201cAppellant\u201d) appeals from the judgment dated 22.03.2018, of the High Court of the North Central Province holden in Anuradhapura, dismissing his application to revise the order of the Magistrate\u2019s Court of Anuradhapura dated 23.02.2018 in Case No. 91215, by which order Appellants ejectment had been directed under the State Lands (Recovery of Possession) Act, No. 7 of 1979, as amended (hereinafter referred to as the \u201cAct\u201d) by the learned Magistrate.",
    "fonts": [
      "Calibri-Light"
    ],
    "sizes": [
      12.960000038146973
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.02,
      422.81,
      152.71,
      435.77
    ],
    "text": "Factual Matrix",
