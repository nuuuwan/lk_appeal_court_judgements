    ],
    "sizes": [
      11.039999961853027
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      108.02,
      72.11,
      526.31,
      85.39
    ],
    "text": "\u201cThe requirement that a person exercising quasi-judicial functions must base his",
