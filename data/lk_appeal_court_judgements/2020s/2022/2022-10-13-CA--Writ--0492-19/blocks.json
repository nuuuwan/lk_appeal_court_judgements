    ]
  },
  {
    "page_number": 5,
    "bbox": [
      108.02,
      655.1,
      526.42,
      669.41
    ],
    "text": "Lord Justice Diplock in R v Deputy Industrial Injuries Commissioner; Ex parte Moore2",
