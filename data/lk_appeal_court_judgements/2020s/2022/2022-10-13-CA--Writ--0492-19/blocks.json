    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      108.02,
      391.72,
      526.41,
      405.0
    ],
    "text": "held that \u201cIt is well settled that in a domestic inquiry the stringent and sophisticated",
    "fonts": [
