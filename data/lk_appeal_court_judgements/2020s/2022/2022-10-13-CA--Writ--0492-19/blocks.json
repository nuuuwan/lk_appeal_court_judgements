    "bbox": [
      108.02,
      734.14,
      403.0,
      769.75
    ],
    "text": "1 Culasubadhra Vs. The University of Colombo (1985) 1 Sri LR 244 at 257. 2 (1965) 1 QB 456, 488.",
    "fonts": [
      "Calibri",
      "Calibri,Italic"
    ],
    "sizes": [
      6.480000019073486,
      9.960000038146973,
      11.039999961853027
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      108.02,
      781.18,
