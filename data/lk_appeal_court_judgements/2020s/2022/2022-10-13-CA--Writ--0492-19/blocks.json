      "Times New Roman,Italic"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      108.02,
      557.34,
      155.06,
      570.62
    ],
    "text": "justice.\u201d.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Italic"
