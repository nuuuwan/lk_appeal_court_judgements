    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      108.02,
      154.93,
      526.15,
      168.21
    ],
    "text": "determined, or to show the likelihood or unlikelihood of the occurrence of some future",
    "fonts": [
      "Times New Roman,Italic"
    ],
    "sizes": [
      12.0
    ]
  },
